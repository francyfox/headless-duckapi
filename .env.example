# ── headless-duckapi configuration ──────────────────────────────────────────────────
# Copy this file to .env and fill in your values:  cp .env.example .env

# REQUIRED — bot token from @BotFather (your bot -> API Token)
BOT_TOKEN=1234567890:AAExampleTokenReplaceMeWithTheRealOne

# Optional — Telegram user ids allowed to run /stats, comma-separated.
# Put the bot owner's id here to grant /stats access;
# add more ids (comma-separated) as needed.
ADMIN_IDS=

# Optional — public https:// URL of this host, used by the 🎛 Настройки
# Mini App button. Telegram only accepts https there. Leave empty to hide
# the button (the /settings command and ⚙️ Статус still work).
# Example: WEBAPP_URL=https://duck.example.com
WEBAPP_URL=

# Webhook — public https:// base URL Telegram delivers updates to; the bot
# registers <WEBHOOK_URL>/api/webhook on boot. Defaults to WEBAPP_URL. With
# neither set to an https:// URL the bot falls back to long polling.
WEBHOOK_URL=

# Optional — secret Telegram sends in X-Telegram-Bot-Api-Secret-Token
# (1-256 chars of A-Z a-z 0-9 _ -). Derived from BOT_TOKEN when empty.
WEBHOOK_SECRET=

# Optional — HTTP port for the Mini App/API server (default 8080)
PORT=8080

# Optional — SQLite storage directory (default ./data)
DATA_DIR=./data
